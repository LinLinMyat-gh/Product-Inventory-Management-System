@model ProductAssignment.Models.ProductModel

@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit</h1>
<h4>@ViewData["Title"]</h4>

<form method="post" enctype="multipart/form-data" class="w-75 mx-auto" id="editForm">
    <div class="mb-3">
        <label for="Id" class="form-label">Product ID</label>
        <input type="text" class="form-control" id="Id" asp-for="Id" readonly />
    </div>

    <div class="mb-3">
        <label for="Name" class="form-label">Product Name</label>
        <input type="text" class="form-control" id="Name" asp-for="Name" required />
    </div>

    <div class="mb-3">
        <label for="Description" class="form-label">Description</label>
        <input type="text" class="form-control" id="Description" asp-for="Description" required />
    </div>

    <div class="mb-3">
        <label for="BuyingPrice" class="form-label">Buying Price (Four Decimal Only)</label>
        <input type="number" step="0.0001" class="form-control" id="BuyingPrice" asp-for="BuyingPrice" required />
    </div>

    <div class="mb-3">
        <label for="Supplier" class="form-label">Supplier Name</label>
        <input type="text" class="form-control" id="Supplier" asp-for="Supplier" required />
    </div>

    <div class="mb-3">
        <label for="ManufacturingDate" class="form-label">Manufacturing Date</label>
        <input type="date" class="form-control" id="ManufacturingDate" asp-for="ManufacturingDate" required />
    </div>

    <div class="mb-3">
        <label for="PurchasingDate" class="form-label">Purchasing Date</label>
        <input type="date" class="form-control" id="PurchasingDate" asp-for="PurchasingDate" required />
    </div>

    <div class="mb-3">
        <label for="ExpiredDate" class="form-label">Expired Date</label>
        <input type="date" class="form-control" id="ExpiredDate" asp-for="ExpiredDate" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Current Product Image</label>
        <br>
        @if (!string.IsNullOrEmpty(Model.ImageFilename))
        {
            <img src="~/images/@Model.ImageFilename" alt="Product Image" class="img-thumbnail" width="150" />
        }
        else
        {
            <span>No image available</span>
        }
    </div>

    <div class="mb-3">
        <label for="ImageFile" class="form-label">Upload New Product Image</label>
        <input type="file" class="form-control" id="ImageFile" name="ImageFile" />
        <small class="text-danger d-none" id="imageError">Please select a valid image file.</small>
    </div>

    

    <div class="mb-3">
        <input type="submit" class="btn btn-info mx-auto d-inline" value="Save" />
        <input type="button" class="btn btn-primary mx-auto d-inline" onclick="window.location.href='@Url.Action("Index", "Product")'" value="Cancel" />
    </div>
</form>

<script>
    $(document).ready(function () {
        $("#editForm").on("submit", function (event) {
            event.preventDefault();

            var formData = new FormData(this);
            var imageFile = $("#ImageFile")[0].files[0];

            // Validate image file type
            if (imageFile && !imageFile.type.startsWith("image/")) {
                $("#imageError").removeClass("d-none");
                return;
            } else {
                $("#imageError").addClass("d-none");
            }

            $.ajax({
                type: "POST",
                url: "@Url.Action("Edit", new { id = Model.Id })",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        showMessage(response.message, "success");
                        window.location.href = '@Url.Action("Index", "Product")';
                    } else {
                        showMessage("Error: " + response.message, "error");
                    }
                },
                error: function () {
                    showMessage("An error occurred while processing the request.", "error");
                }
            });
        });

        function showMessage(message, type) {
            alert(message); // Replace this with a styled notification if needed
        }
    });
</script>
