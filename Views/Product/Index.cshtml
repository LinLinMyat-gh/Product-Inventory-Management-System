@model X.PagedList.StaticPagedList<ProductAssignment.Models.ProductModel>


@{
    ViewData["Title"] = "Available Products";
}

<h1>Product Management System</h1>
<h4>@ViewData["Title"]</h4>

<a asp-controller="Product" asp-action="Create" class="btn btn-primary float-end my-2">Create New Product</a>

<div class="table-responsive">

<table class="table table-hover align-middle modern-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Buying Price</th>
            <th>Supplier</th>
            <th>Manufacturing Date</th>
            <th>Purchasing Date</th>
            <th>Expired Date</th>
            <th style="width: 200px;">Image</th>
            <th style="width: 300px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@Html.DisplayFor(model => product.Id)</td>
                <td>@Html.DisplayFor(model => product.Name)</td>
                <td>@Html.DisplayFor(model => product.Description)</td>
                <td>@Html.DisplayFor(model => product.BuyingPrice)</td>
                <td>@Html.DisplayFor(model => product.Supplier)</td>
                <td>@Html.DisplayFor(model => product.ManufacturingDate)</td>
                <td>@Html.DisplayFor(model => product.PurchasingDate)</td>
                <td>@Html.DisplayFor(model => product.ExpiredDate)</td>
                <td style="width: 200px; height: 100px; text-align: center;">
                    @if (!string.IsNullOrEmpty(product.ImageFilename))
                    {
                        <img src="@($"/images/{product.ImageFilename}")"
                             alt="Product Image" 
                             width="150" height="150" 
                             class="img-thumbnail" />
                    }
                    else 
                    {
                        <span>No Image</span>
                    }
                </td>
                <td>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Product"
                        asp-action="Edit"
                        asp-route-id="@product.Id"
                        class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            Edit
                        </a>

                        <a asp-controller="Product"
                        asp-action="Delete"
                        asp-route-id="@product.Id"
                        class="btn btn-outline-danger btn-sm rounded-pill px-3"
                        onclick="return confirm('Are you sure you want to delete this product?');">
                            Delete
                        </a>

                    </div>

                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Pagination Controls -->
<nav aria-label="Page navigation" class="d-flex justify-content-between align-items-center">
    <div>
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize"
               class="btn btn-outline-primary btn-sm">&laquo; Previous</a>
        }
    </div>

    <ul class="pagination pagination-sm mb-0">
        @for (int i = 1; i <= Model.PageCount; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize" class="page-link">@i</a>
            </li>
        }
    </ul>

    <div>
        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize"
               class="btn btn-outline-primary btn-sm">Next &raquo;</a>
        }
    </div>
</nav>

<!-- Page Size Selector -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <form asp-action="Index" method="get" class="form-inline">
        <label for="pageSize" class="mr-2 small">Records per page:</label>
        <select id="pageSize" name="pageSize" asp-for="@Model.PageSize" class="form-control form-control-sm" onchange="this.form.submit()">
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="10">10</option>
        </select>
    </form>
    <p class="mb-0 small">Total Records: @Model.TotalItemCount | Current Page: @Model.PageNumber | Total Pages: @Model.PageCount</p>
</div>