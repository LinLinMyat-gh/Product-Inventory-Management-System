@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold display-5">
            About This Project
        </h1>

        <p class="text-muted lead">
            ASP.NET MVC Product Inventory Management System
        </p>

    </div>

    <!-- PROJECT OVERVIEW -->

    <div class="card shadow-sm border-0 rounded-4 p-5 mb-5">

        <h2 class="fw-bold mb-4">
            Project Overview
        </h2>

        <p class="text-muted">
            This project is a modern Product Inventory Management System
            developed using ASP.NET MVC and SQLite database.

            The system allows users to create, update, delete,
            and manage product information efficiently through
            a responsive and user-friendly interface.
        </p>

    </div>

    <!-- FEATURES -->

    <div class="card shadow-sm border-0 rounded-4 p-5 mb-5">

        <h2 class="fw-bold mb-4">
            Features Implemented
        </h2>

        <div class="row">

            <div class="col-md-6">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        CRUD Operations
                    </li>

                    <li class="list-group-item">
                        Product Image Upload
                    </li>

                    <li class="list-group-item">
                        Responsive UI Design
                    </li>

                    <li class="list-group-item">
                        Pagination System
                    </li>

                </ul>

            </div>

            <div class="col-md-6">

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        SQLite Database Integration
                    </li>

                    <li class="list-group-item">
                        Dynamic Dashboard Statistics
                    </li>

                    <li class="list-group-item">
                        Bootstrap 5 Styling
                    </li>

                    <li class="list-group-item">
                        ASP.NET MVC Architecture
                    </li>

                </ul>

            </div>

        </div>

    </div>

    <!-- TECHNOLOGIES -->

    <div class="about-card">

        <h2 class="fw-bold mb-4">
            Technologies Used
        </h2>

        <div class="row">

            <div class="col-md-4">

                <div class="p-3 border rounded-4 text-center">
                    <h5>Frontend</h5>
                    <p class="text-muted">
                        HTML, CSS, Bootstrap 5
                    </p>
                </div>

            </div>

            <div class="col-md-4">

                <div class="p-3 border rounded-4 text-center">
                    <h5>Backend</h5>
                    <p class="text-muted">
                        ASP.NET MVC, C#
                    </p>
                </div>

            </div>

            <div class="col-md-4">

                <div class="p-3 border rounded-4 text-center">
                    <h5>Database</h5>
                    <p class="text-muted">
                        SQLite, Entity Framework
                    </p>
                </div>

            </div>

        </div>

    </div>

    <!-- DEVELOPER -->

    <div class="card shadow-sm border-0 rounded-4 p-5">

        <h2 class="fw-bold mb-4">
            Developer Information
        </h2>

        <p class="text-muted">
            This project was developed by Lin Lin Myat to demonstrate practical experience
            in ASP.NET MVC, Entity Framework, SQLite database integration,
            responsive web design, and full-stack application development
            through a modern product inventory management system.
        </p>

    </div>

</div>