@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- HERO SECTION -->
    <div class="row align-items-center mb-5">

        <div class="col-md-6">

            <h1 class="display-4 fw-bold mb-3">
                Product Inventory Management System
            </h1>

            <p class="lead text-muted mb-4">
                A modern ASP.NET MVC application for managing products,
                suppliers, inventory, and product images efficiently.
            </p>

            <a href="/Product"
            class="btn btn-dark btn-lg rounded-pill px-4 me-2">
                View Products
            </a>         

            <a href="/Product/Create"
            class="btn btn-outline-primary btn-lg rounded-pill px-4">
                Create New Product
            </a>

        </div>

        <div class="col-md-6 text-center">

            <img src="https://cdn-icons-png.flaticon.com/512/3081/3081559.png"
                 width="350"
                 class="img-fluid" />

        </div>

    </div>

