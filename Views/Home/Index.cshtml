    <div class="text-center mb-5">

        <h2 class="fw-bold mb-3">
            System Features
        </h2>

        <p class="text-muted">
            Functionalities implemented in this ASP.NET MVC project
        </p>

    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">

